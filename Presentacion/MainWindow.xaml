<Window x:Class="Presentacion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gestión de Personas | Laboratorio 7" Height="720" Width="1120" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#172033" CornerRadius="16" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="LABORATORIO 07  /  SISTEMA DE PERSONAS" Foreground="#9FB5D9" FontSize="11" FontWeight="Bold"/><TextBlock Text="Gestión de personas" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="CRUD por capas · WPF · ADO.NET · SQL Server" Foreground="#C6D2E5" FontSize="13"/></StackPanel></Border>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Directorio" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Registra, consulta y administra los registros activos." Foreground="#68758B" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="●  CONEXIÓN SQL SERVER" Foreground="#16845B" FontSize="11" FontWeight="Bold"/></Border></Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="NOMBRE COMPLETO" FontSize="10" FontWeight="Bold" Foreground="#68758B" Margin="0,0,0,6"/><TextBox x:Name="txtNombre" Height="36" Padding="9,7" BorderBrush="#DCE3EF"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="DNI" FontSize="10" FontWeight="Bold" Foreground="#68758B" Margin="0,0,0,6"/><TextBox x:Name="txtDni" Height="36" Padding="9,7" BorderBrush="#DCE3EF" MaxLength="8"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="TELÉFONO" FontSize="10" FontWeight="Bold" Foreground="#68758B" Margin="0,0,0,6"/><TextBox x:Name="txtTelefono" Height="36" Padding="9,7" BorderBrush="#DCE3EF" MaxLength="15"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Bottom"><Button x:Name="btnGuardar" Content="＋  Registrar" Height="36" Padding="16,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="Guardar_Click"/></StackPanel></Grid></Border>
  <Border Grid.Row="3" Background="White" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Personas registradas" FontSize="16" FontWeight="SemiBold" Foreground="#172033"/><TextBlock x:Name="lblTotal" Text="0 registros activos" FontSize="11" Foreground="#7B879A" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="txtBuscar" Grid.Column="1" Height="36" Padding="10,7" VerticalContentAlignment="Center" BorderBrush="#DCE3EF" TextChanged="Buscar_TextChanged" ToolTip="Buscar por nombre o DNI"/><Button Grid.Column="2" Content="Limpiar" Margin="8,0,0,0" Padding="13,0" Height="36" Background="#EEF2F8" Foreground="#344054" BorderThickness="0" Click="Limpiar_Click"/></Grid><DataGrid x:Name="dgPersonas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Personas_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42" AlternatingRowBackground="#F8FAFD"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding IdPersona}" Width="70"/><DataGridTextColumn Header="NOMBRE COMPLETO" Binding="{Binding NombreCompleto}" Width="*"/><DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="150"/><DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="180"/></DataGrid.Columns></DataGrid></Grid></Border>
  <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Los registros eliminados se conservan en la base de datos (eliminación lógica)." Foreground="#7B879A" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Limpiar formulario" Padding="14,9" Margin="0,0,8,0" Background="#E8EDF5" Foreground="#344054" BorderThickness="0" Click="Limpiar_Click"/><Button Content="Actualizar" Padding="18,9" Margin="0,0,8,0" Background="#0F766E" Foreground="White" BorderThickness="0" Click="Actualizar_Click"/><Button Content="Eliminar" Padding="18,9" Background="#FDECEC" Foreground="#B42318" BorderThickness="0" Click="Eliminar_Click"/></StackPanel></Grid>
 </Grid></Window>
